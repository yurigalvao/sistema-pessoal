# Ambiente virtual — cada dev cria o seu localmente, não faz sentido versionar
venv/
env/

# Variáveis de ambiente / segredos — NUNCA sobe isso pro Git
.env
*.env.local

# Bytecode do Python — arquivos compilados, gerados automaticamente
__pycache__/
*.pyc
*.pyo

# Banco de dados local (se usar SQLite no início)
db.sqlite3

# Arquivos estáticos e de mídia coletados (gerados pelo Django, não código-fonte)
staticfiles/
media/

# Migrations? -> NÃO ignore. Migrations do Django DEVEM ir pro Git,
# é o que mantém o histórico do schema do banco sincronizado no time.

# Arquivos de IDE/editor
.vscode/
.idea/
*.swp

# Sistema operacional
.DS_Store
Thumbs.db

# Logs
*.log
